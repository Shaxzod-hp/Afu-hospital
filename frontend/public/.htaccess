# Vue Router (history mode) uchun: /doctors/ali kabi sahifa yangilanganda
# 404 o'rniga index.html qaytarilsin. Apache hostinglar uchun.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS ga majburiy yo'naltirish
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Hash nomli asset fayllar uzoq keshlansin, index.html esa keshlanmasin
<IfModule mod_headers.c>
    # Vite js/css/font fayllari nomida hash bor — ular hech qachon o'zgarmaydi
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # public/ dagi rasm/video nomlarida hash yo'q — qisqaroq kesh
    <FilesMatch "\.(png|jpe?g|webp|svg|ico|mp4)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
